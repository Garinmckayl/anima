 "profile": "explanatory",
 "document": {
  "id": "crispr-cas9-cleavage",
  "title": "CRISPR-Cas9 endonuclease DNA cleavage mechanism",
  "revision": 1,
  "description": "R-loop mediated target recognition, HNH activation and double-strand cleavage by SpCas9, with an on-target / seed-mismatch comparison."
 },
 "requirements": {
  "capabilities": [
   "scene.svg",
   "behavior.clock",
   "behavior.enum",
   "behavior.expressions",
   "presentation.readouts"
  ]
 },
 "biology": {
  "entities": {
   "cas9": {
    "kind": "complex",
    "label": "SpCas9–sgRNA–DNA complex",
    "species": "Streptococcus pyogenes",
    "claimIds": [
     "c_structure_basis"
    ],
    "description": "Streptococcus pyogenes Cas9 in complex with single-guide RNA and target DNA, as modelled in this figure."
   },
   "rec_lobe": {
    "kind": "protein-domain",
    "label": "REC Lobe",
    "partOf": "cas9",
    "description": "Recognition lobe (REC1, REC2, REC3). Alpha-helical structural scaffold that wraps around the 20-bp guide RNA:target DNA heteroduplex.",
    "claimIds": [
     "c_rec_lobe"
    ]
   },
   "bridge_helix": {
    "kind": "protein-domain",
    "label": "Bridge Helix (BH)",
    "partOf": "cas9",
    "description": "Conserved arginine-rich alpha-helix (Arg63–Lys94) initiating DNA unwinding upon target interrogation.",
    "claimIds": [
     "c_bridge_helix"
    ]
   },
   "pi_domain": {
    "kind": "protein-domain",
    "label": "PAM-Interacting (PI) Domain",
    "partOf": "cas9",
    "description": "Interrogates the major groove of target DNA for the 5'-NGG-3' protospacer adjacent motif via conserved Arg1333 and Arg1335.",
    "claimIds": [
     "c_pam_recognition"
    ]
   },
   "ruvc_domain": {
    "kind": "protein-domain",
    "label": "RuvC Domain",
    "partOf": "cas9",
    "description": "Ribonuclease H-fold domain that hydrolyzes the displaced non-target strand (NTS) at position -3 relative to PAM using Asp10, Glu762, and Asp986.",
    "claimIds": [
     "c_catalytic_cleavage"
    ]
   },
   "hnh_domain": {
    "kind": "protein-domain",
    "label": "HNH Nuclease Domain",
    "partOf": "cas9",
    "description": "Mobile catalytic domain. In inactive state, rests docked against REC2/RuvC; upon full R-loop formation, rotates ~180° (30 Å) to hydrolyze TS via Asp839, His840, Asn863.",
    "claimIds": [
     "c_rloop_allostery",
     "c_catalytic_cleavage"
    ]
   },
   "sgrna": {
    "kind": "rna",
    "label": "gRNA Scaffold / tracrRNA",
    "description": "Structured crRNA:tracrRNA duplex consisting of tetraloop, stem loop 1, stem loop 2 and stem loop 3 accommodated on the REC surface.",
    "claimIds": [
     "c_scaffold"
    ]
   },
   "target_strand": {
    "kind": "dna",
    "label": "Target strand (TS)",
    "description": "DNA strand complementary to the guide RNA spacer; cleaved by the HNH domain.",
    "claimIds": [
     "c_catalytic_cleavage"
    ]
   },
   "non_target_strand": {
    "kind": "dna",
    "label": "Non-Target Strand (NTS)",
    "description": "Strand unwound by Cas9 during RNA:DNA heteroduplex invasion. Threaded across RuvC catalytic residues Asp10/His983.",
    "claimIds": [
     "c_catalytic_cleavage"
    ]
   },
   "pam_motif": {
    "kind": "dna",
    "label": "PAM Region (5'-NGG-3')",
    "description": "Conserved dinucleotide G-G motif on the non-target strand recognized in the minor/major groove by Cas9 C-terminal domain.",
    "claimIds": [
     "c_pam_recognition"
    ]
   },
   "distal_dna": {
    "kind": "dna",
    "label": "PAM-Distal Target DNA",
    "description": "Upstream B-form double-stranded DNA duplex extending beyond the 20-bp protospacer target sequence."
   },
   "r_loop": {
    "kind": "complex",
    "label": "RNA:DNA Heteroduplex (R-Loop)",
    "description": "20-nucleotide hybrid duplex formed between the target DNA strand (cyan) and guide RNA spacer (amber). Drives allosteric activation.",
    "claimIds": [
     "c_rloop_allostery"
    ]
   },
   "seed_mismatch": {
    "kind": "condition",
    "label": "PAM-proximal seed mismatch",
    "description": "Mismatch between guide and target within the PAM-proximal seed region.",
    "claimIds": [
     "c_seed_mismatch"
    ]
   }
  },
  "relationships": {
   "pam_recognition": {
    "kind": "binds",
    "source": "pi_domain",
    "target": "pam_motif",
    "claimIds": [
     "c_pam_recognition"
    ]
   },
   "r_loop_formation": {
    "kind": "hybridizes",
    "source": "sgrna",
    "target": "target_strand",
    "claimIds": [
     "c_rloop_formation"
    ]
   },
   "rloop_activates_hnh": {
    "kind": "activates",
    "source": "r_loop",
    "target": "hnh_domain",
    "claimIds": [
     "c_rloop_allostery"
    ]
   },
   "hnh_cleaves_ts": {
    "kind": "cleaves",
    "source": "hnh_domain",
    "target": "target_strand",
    "claimIds": [
     "c_catalytic_cleavage"
    ]
   },
   "ruvc_cleaves_nts": {
    "kind": "cleaves",
    "source": "ruvc_domain",
