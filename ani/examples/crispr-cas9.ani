 "presentation": {
  "defaultScene": "overview",
  "plate": {
   "figureLabel": "FIG 01 · SP-CAS9 ENDONUCLEASE",
   "title": "R-LOOP MEDIATED DNA TARGETING & CLEAVAGE",
   "hint": "HOVER DOMAINS · TOGGLE TARGET FIDELITY · DRAG TIME",
   "summaryReadoutId": "summary"
  },
  "readouts": {
   "summary": {
    "label": "Summary",
    "value": {
     "op": "concat",
     "args": [
      "PAM: BOUND | R-LOOP: ",
      {
       "op": "str",
       "args": [
        {
         "op": "ref",
         "id": "pairs"
        }
       ]
      },
      "/20 nt | HNH: ",
      {
       "op": "ref",
       "id": "hnh_state"
      }
     ]
    }
   },
   "rloop": {
    "label": "Target Annealing & R-Loop",
    "claimIds": [
     "c_rloop_formation",
     "c_seed_mismatch"
    ],
    "value": {
     "op": "concat",
     "args": [
      {
       "op": "str",
       "args": [
        {
         "op": "ref",
         "id": "pairs"
        }
       ]
      },
      " / 20 bp (",
      {
       "op": "if",
       "args": [
        {
         "op": "not",
         "args": [
          {
           "op": "ref",
           "id": "is_match"
          }
         ]
        },
        "Seed mismatch",
        {
         "op": "if",
         "args": [
          {
           "op": "ge",
           "args": [
            {
             "op": "ref",
             "id": "pairing"
            },
            1
           ]
          },
          "Full zippering",
          "Zippering"
         ]
        }
       ]
      },
      ")"
     ]
    },
    "description": {
     "op": "if",
     "args": [
      {
       "op": "ref",
       "id": "is_match"
      },
      "Guide RNA pairs with the complementary target DNA, forming the R-loop.",
      "The chosen seed mismatch stalls pairing and blocks the catalytic checkpoint in this illustration."
     ]
    }
   },
   "hnh": {
    "label": "HNH Conformation",
    "claimIds": [
     "c_rloop_allostery"
    ],
    "value": {
     "op": "if",
     "args": [
      {
       "op": "not",
       "args": [
        {
         "op": "ref",
         "id": "is_match"
        }
       ]
      },
      "Inactive (Checkpoint)",
      {
       "op": "if",
       "args": [
        {
         "op": "gt",
         "args": [
          {
           "op": "ref",
           "id": "dock"
          },
          0.95
         ]
        },
        "Active (Catalytic Docked)",
        {
         "op": "if",
         "args": [
          {
           "op": "gt",
           "args": [
            {
             "op": "ref",
             "id": "dock"
            },
            0
           ]
          },
          "Docking to target strand",
          "Inactive (Undocked)"
         ]
        }
       ]
      }
     ]
    },
    "description": {
     "op": "if",
     "args": [
      {
       "op": "ref",
       "id": "is_match"
      },
      "R-loop formation permits HNH to dock near the target-strand cleavage site.",
      "The HNH domain remains undocked in the mismatch state."
     ]
    }
   },
   "cleavage": {
    "label": "Cleavage State",
    "claimIds": [
     "c_catalytic_cleavage"
    ],
    "value": {
     "op": "if",
     "args": [
      {
       "op": "ref",
       "id": "cut"
      },
      "Dual Hydrolysis (DSB)",
      {
       "op": "if",
       "args": [
        {
         "op": "not",
         "args": [
          {
           "op": "ref",
           "id": "is_match"
          }
         ]
        },
        "Cleavage blocked",
        "DNA intact"
       ]
      }
     ]
    },
    "description": {
     "op": "if",
     "args": [
      {
       "op": "ref",
       "id": "cut"
      },
      "Both strands are cut upstream of the PAM. Cas9 remains bound to the DNA products.",
      {
       "op": "if",
       "args": [
        {
         "op": "not",
         "args": [
          {
           "op": "ref",
           "id": "is_match"
          }
         ]
        },
        "This mismatch state does not pass the cleavage checkpoint.",
        "Recognition and conformational activation precede cleavage."
       ]
      }
     ]
    }
   }
