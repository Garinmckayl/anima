    }
   },
   "c_pam_recognition": {
    "statement": "The PAM-interacting domain reads the 5'-NGG-3' protospacer adjacent motif in the major groove of target DNA via Arg1333 and Arg1335.",
    "kind": "established",
    "describes": [
     {
